+                                                     const xcb_present_notify_t *);
+
+    PFN_allocate allocate   = nullptr;
+    PFN_describe describe   = nullptr;
+    PFN_release release     = nullptr;
+    PFN_send sendHandle     = nullptr;
+    PFN_dri3_pixmap_from_buffers dri3PixmapFromBuffers = nullptr;
+    PFN_present_pixmap presentPixmap                   = nullptr;
+    bool loaded             = false;
+
+    bool init()
+    {
+        if (loaded)
+        {
+            return allocate && describe && release && sendHandle && dri3PixmapFromBuffers &&
+                   presentPixmap;
+        }
+        loaded       = true;
+        void *libAnd = dlopen("libandroid.so", RTLD_LAZY);
+        if (!libAnd)
