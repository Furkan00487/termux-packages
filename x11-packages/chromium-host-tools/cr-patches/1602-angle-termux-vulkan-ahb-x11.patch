+    using PFN_present_pixmap = xcb_void_cookie_t (*)(xcb_connection_t *,
+                                                     xcb_window_t,
+                                                     xcb_pixmap_t,
+                                                     uint32_t,
+                                                     xcb_xfixes_region_t,
+                                                     xcb_xfixes_region_t,
+                                                     int16_t,
+                                                     int16_t,
+                                                     xcb_randr_crtc_t,
