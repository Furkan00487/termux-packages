+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef MEDIA_FILTERS_TERMUX_MEDIACODEC_VIDEO_DECODER_H_
+#define MEDIA_FILTERS_TERMUX_MEDIACODEC_VIDEO_DECODER_H_
+
+#include <memory>
+
+#include "base/containers/queue.h"
+#include "base/functional/callback.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/sequence_checker.h"
+#include "media/base/media_export.h"
+#include "media/base/video_decoder.h"
+#include "media/base/video_decoder_config.h"
+
+namespace media {
+
+class MediaLog;
+
+// Hardware-accelerated video decoder backed by Android NDK libmediandk.so
+// (AMediaCodec) for Termux Bionic builds. Targets codecs backed by vendor
+// hardware decoders (e.g. H.264, HEVC, VP8 on Exynos) and cleanly declines
+// unsupported codecs (VP9, AV1) or encrypted streams so Chromium falls back to
+// libvpx / dav1d / FFmpeg.
+class MEDIA_EXPORT TermuxMediaCodecVideoDecoder : public VideoDecoder {
+ public:
+  static bool IsCodecSupported(VideoCodec codec);
+
+  explicit TermuxMediaCodecVideoDecoder(std::unique_ptr<MediaLog> media_log);
+
+  TermuxMediaCodecVideoDecoder(const TermuxMediaCodecVideoDecoder&) = delete;
+  TermuxMediaCodecVideoDecoder& operator=(const TermuxMediaCodecVideoDecoder&) =
+      delete;
+
+  ~TermuxMediaCodecVideoDecoder() override;
+
+  // VideoDecoder implementation.
+  VideoDecoderType GetDecoderType() const override;
+  bool NeedsBitstreamConversion() const override;
+  void Initialize(const VideoDecoderConfig& config,
+                  bool low_delay,
+                  CdmContext* cdm_context,
+                  InitCB init_cb,
+                  const OutputCB& output_cb,
+                  const WaitingCB& waiting_cb) override;
+  void Decode(scoped_refptr<DecoderBuffer> buffer, DecodeCB decode_cb) override;
+  void Reset(base::OnceClosure closure) override;
+
+ private:
+  struct CodecHandle;
+
+  void ReleaseCodec();
+  void DrainOutputBuffers(bool draining_eos);
+  scoped_refptr<VideoFrame> CopyOutputFrame(const uint8_t* data,
+                                            size_t size,
+                                            base::TimeDelta pts);
+
+  SEQUENCE_CHECKER(sequence_checker_);
+
+  const std::unique_ptr<MediaLog> media_log_;
+  VideoDecoderConfig config_;
+  OutputCB output_cb_;
+  std::unique_ptr<CodecHandle> codec_;
+
+  int32_t out_width_ = 0;
+  int32_t out_height_ = 0;
+  int32_t out_stride_ = 0;
+  int32_t out_slice_height_ = 0;
+  int32_t out_color_format_ = 21;  // COLOR_FormatYUV420SemiPlanar (NV12)
+  bool initialized_ = false;
+  bool eos_seen_ = false;
+};
+
+}  // namespace media
+
+#endif  // MEDIA_FILTERS_TERMUX_MEDIACODEC_VIDEO_DECODER_H_
