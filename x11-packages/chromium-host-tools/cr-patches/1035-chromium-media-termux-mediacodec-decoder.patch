+  base::test::SingleThreadTaskEnvironment env;
+  TermuxMediaCodecVideoDecoder decoder(std::make_unique<NullMediaLog>());
+  EXPECT_EQ(decoder.GetDecoderType(), VideoDecoderType::kMediaCodec);
